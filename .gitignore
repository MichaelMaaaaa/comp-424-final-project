# Only the starter code is tracked: everything is ignored, then the files below are let back in.
# To commit a new file of your own, add a line "!/<path>" below, or use: git add -f <path>

/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/authors.yaml

!/constants.py
!/helpers.py
!/store.py
!/world.py
!/runners.py
!/simulator.py
!/ui.py
!/validate_submission.py
!/allowed_imports.py

!/agents/
/agents/*
!/agents/__init__.py
!/agents/agent.py
!/agents/random_agent.py
!/agents/greedy_agent.py
!/agents/human_agent.py
!/agents/student_agent.py

!/game_rules.txt
!/export_book.py
!/baselines/
!/summarize_results.py
!/notes/
!/experiments/
!/search_experiments/
!/tests/
!/agents/search_engine.py
!/agents/experiment_agent.py
!/agents/book_policy.py
!/book_experiments/

# Generated formal runs stay local; the committed examples are small self-tests.
/experiments/a_run/
/experiments/a_smoke/
/search_experiments/__pycache__/
/tests/__pycache__/
/experiments/b_run/
/experiments/b_smoke/
/experiments/b_examples/**/opponents/
/experiments/b_examples/**/logs/
/experiments/b_examples/**/candidate/
/book_experiments/__pycache__/

__pycache__/
